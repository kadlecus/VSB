@{
}

<div class="container mt-5">

    <h2 class="mb-4">Hledat rezervace uživatele</h2>

    <form asp-action="SearchDetail" method="post" class="mb-5">
        <div class="mb-3">
            <label for="Email" class="form-label">E-mail uživatele:</label>
            <input type="text" name="Email" class="form-control" placeholder="user@example.cz" />
        </div>
        <button type="submit" class="btn btn-primary">Vyhledat</button>
    </form>

    @if (ViewBag.AdminReservation != null)
    {
        <h3 class="mb-3">Aktivní rezervace</h3>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Parkoviště</th>
                    <th>Místo</th>
                    <th>Od</th>
                    <th>Do</th>
                    <th>Cena</th>
                    <th>Email</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in ViewBag.AdminReservation)
                {
                    <tr>
                        <td>@r.ParkingLotName</td>
                        <td>@r.ParkingSpotId</td>
                        <td>@r.StartTime.ToString("g")</td>
                        <td>@r.EndTime.ToString("g")</td>
                        <td>@r.Price Kč</td>
                        <td>@r.UserEmail</td>
                        <td>
                            <a asp-action="EditReservation" asp-route-id="@r.Id" class="btn btn-sm btn-warning me-2">Upravit</a>
                            <a asp-action="DeleteReservation" asp-route-reservationId="@r.Id" class="btn btn-sm btn-danger"
                               onclick="return confirm('Opravdu chcete tuto rezervaci smazat?');">
                                Smazat
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        else if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
    }

    @if (ViewBag.AdminHistoryReservation != null)
    {
        <h3 class="mt-5 mb-3">Historie rezervací</h3>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Parkoviště</th>
                    <th>Místo</th>
                    <th>SPZ</th>
                    <th>Od</th>
                    <th>Do</th>
                    <th>Cena</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in ViewBag.AdminHistoryReservation)
                {
                    <tr>
                        <td>@r.ParkingLotName</td>
                        <td>@r.ParkingSpotId</td>
                        <td>@r.LicensePlate</td>
                        <td>@r.StartTime.ToString("g")</td>
                        <td>@r.EndTime.ToString("g")</td>
                        <td>@r.Price Kč</td>
                        <td>@r.UserEmail</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        else if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
    }

</div>
