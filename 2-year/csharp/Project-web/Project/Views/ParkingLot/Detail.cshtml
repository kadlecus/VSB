@{
}

<div class="container mt-5">

    <h2 class="mb-4">Parkovací místa pro parkoviště s ID: @ViewBag.ParkingLotId</h2>

    @if (Context.Session.GetString("Role") != "Admin")
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID Parkovacího místa</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ParkingSpot spot in ViewBag.ParkingSpots)
                    {
                        <tr>
                            <td>@spot.Id</td>
                            <td>@spot.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Context.Session.GetString("Role") == "Admin")
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID Parkovacího místa</th>
                        <th>Status</th>
                        <th>Aktuální stav</th>
                        <th>Změnit stav</th>
                        <th>Historie</th>
                        <th>Odstranit</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (ParkingSpot spot in ViewBag.AdminSpots)
                    {
                        <tr>
                            <td>@spot.Id</td>
                            <td>@spot.Status</td>
                            <td>@spot.ManualStatus</td>
                            <td>
                                <form method="post" asp-action="EditStatus" asp-controller="ParkingLot" asp-route-status="@spot.Status" class="d-flex align-items-center">
                                    <input type="hidden" name="spotid" value="@spot.Id" />
                                    <select name="newStatus" class="form-select me-2">
                                        <option value="Dostupné" selected="@(spot.ManualStatus == "Dostupné" ? "selected" : null)">Dostupné</option>
                                        <option value="V údržbě" selected="@(spot.ManualStatus == "V údržbě" ? "selected" : null)">V údržbě</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm">Uložit</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-action="SpotHistory" asp-controller="ParkingLot" class="d-flex align-items-center">
                                    <input type="hidden" name="spotid" value="@spot.Id" />

                                    <button type="submit" class="btn btn-primary btn-sm">Historie</button>
                                </form>
                            </td>
                            <td>
                                <form method="post" asp-action="DeleteSpot" asp-controller="ParkingLot" class="d-flex align-items-center">
                                    <input type="hidden" name="spotid" value="@spot.Id" />
                                   
                                    <button type="submit" class="btn btn-danger btn-sm">Smazat</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <form method="post" asp-action="AddParkingSpot" asp-controller="ParkingLot" asp-route-lotid="@ViewBag.ParkingLotId">
                <button type="submit" class="btn btn-success">Přidat nové místo</button>
            </form>
        </div>
    }

    @if (Context.Session.GetString("Role") == "Registered")
    {
        <div class="mt-4">
            <form action="@Url.Action("CreateReservation", new { id = ViewBag.ParkingLotId })" method="post">
                <button type="submit" class="btn btn-success">Vytvořit rezervaci</button>
            </form>
        </div>
    }

    @if (Context.Session.GetString("Role") == "Admin")
    {
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        else if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["SuccessAdd"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show mt-4" role="alert">
                @TempData["SuccessAdd"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    }

</div>
