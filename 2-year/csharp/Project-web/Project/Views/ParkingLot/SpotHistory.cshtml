@{
    var spotHistory = ViewBag.SpotHistory as IEnumerable<Project.Models.ParkingStatusHistory>;
}

<div class="container mt-5">
    <h2 class="mb-4">Historie změn parkovacího místa</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (spotHistory != null && spotHistory.Any())
            {
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Parkoviště ID</th>
                            <th>Parkovací místo ID</th>
                            <th>Nový stav</th>
                            <th>Změněno</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in spotHistory)
                        {
                            <tr>
                                <td>@history.Id</td>
                                <td>@history.ParkingLotId</td>
                                <td>@history.ParkingSpotId</td>
                                <td>@history.NewStatus</td>
                                <td>@history.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Žádná historie pro toto místo nebyla nalezena.</p>
            }
        </div>
    </div>
</div>
