@{
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

<style>
    #map {
        height: 400px;
        width: 100%;
        margin-bottom: 30px;
        border: 2px solid #ddd;
        border-radius: 8px;
    }
</style>

<div class="container mt-5">

    <h2 class="mb-4">Mapa parkovišť</h2>

    <div id="map"></div>

    <h3 class="mt-5 mb-3">Seznam parkovišť</h3>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID Parkoviště</th>
                    <th>Název</th>
                    <th>Šířka</th>
                    <th>Délka</th>
                    <th>Volná místa</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parkingLot in ViewBag.ParkingLots)
                {
                    <tr>
                        <td>@parkingLot.Id</td>
                        <td>
                            <a asp-controller="ParkingLot" asp-action="Detail" asp-route-id="@parkingLot.Id">
                                @parkingLot.Name
                            </a>
                        </td>
                        <td>@parkingLot.Latitude</td>
                        <td>@parkingLot.Longitude</td>
                        <td>@parkingLot.FreeSpots</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<script>
    var map = L.map('map').setView([49.78077000449939, 18.429110810379083], 13);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    var parkingLots = @Html.Raw(Json.Serialize(ViewBag.ParkingLots));

    parkingLots.forEach(function (lot) {
        if (lot.latitude && lot.longitude) {
            L.marker([lot.latitude, lot.longitude])
                .addTo(map)
                .bindPopup(`<b>${lot.name}</b><br>Počet volných míst: <b>${lot.freeSpots}</b><br><a href="/ParkingLot/Detail/${lot.id}">Detail</a>`);
        }
    });
</script>
