<Window x:Class="desktop_projekt.UpdateReservation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_projekt"
        mc:Ignorable="d"
        Title="UpdateReservation" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Začátek:" Margin="0,0,0,5"/>
                <DatePicker Name="StartDatePicker" Margin="0,0,0,5" Width="150"/>
                <TextBox Name="StartTimeTextBox" Width="60" Margin="5,0,0,0" Text="08:00"/>

            </StackPanel>
            <StackPanel>
                <TextBlock Text="Konec" Margin="0,0,0,5"/>
                <DatePicker Name="EndDatePicker" Width="150" Margin="0,0,0,5"/>
                <TextBox Name="EndTimeTextBox" Margin="0,0,0,5" Width="60" Text="9:00"/>
            </StackPanel>
            <TextBlock Text="SPZ:" Margin="0,10,0,5"/>
            <TextBox Name="LicensePlate" Width="200"/>

            <TextBlock Text="Email:" Margin="0,0,0,5"/>
            <TextBox Name="Email" Width="200"/>
            <Button Content="Rezervovat" Width="120" Click="SendUpdatedReservation_Click" Margin="0,0,0,5" />
        </StackPanel>
    </Grid>
</Window>
