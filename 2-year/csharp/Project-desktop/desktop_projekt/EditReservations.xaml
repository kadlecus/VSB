<Window x:Class="desktop_projekt.EditReservations"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EditReservations" Height="500" Width="1000">
    <Grid Margin="10">

    
        <DataGrid Name="EditReservationsGrid"
                  AutoGenerateColumns="False"
                  Margin="0,0,0,50"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Height="380">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ParkingLotId" Binding="{Binding ParkingLotId}" Width="90"/>
                <DataGridTextColumn Header="ParkingSpotId" Binding="{Binding ParkingSpotId}" Width="90"/>
                <DataGridTextColumn Header="LicensePlate" Binding="{Binding LicensePlate}" Width="90"/>
                <DataGridTextColumn Header="StartTime" Binding="{Binding StartTime}" Width="100"/>
                <DataGridTextColumn Header="EndTime" Binding="{Binding EndTime}" Width="100"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="70"/>
                <DataGridTextColumn Header="UserEmail" Binding="{Binding UserEmail}" Width="150"/>
                <DataGridTemplateColumn Header="Upravit" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Update" Click="UpdateButton_Click" Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Smazat" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteButton_Click" Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

  
        <Button Content="Načíst rezervace"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0"
                Width="150" Height="30"
                Click="ShowReservations_Click"/>

    </Grid>
</Window>
